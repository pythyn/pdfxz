/* pdfxz TUI stylesheet: dark theme, restrained color, compact and consistent. */

Screen {
    background: $surface;
}

#config-body,
#processing-body,
#report-body {
    padding: 0 2;
}

#title {
    text-style: bold;
    color: $text;
    background: $accent;
    content-align: center middle;
    height: 1;
    margin-top: 1;
    text-align: center;
}

#subtitle {
    color: $text-muted;
    content-align: center middle;
    height: 1;
    margin-bottom: 1;
    text-align: center;
}

.field-label {
    color: $text-muted;
    text-style: bold;
    height: 1;
    margin-top: 1;
}

.field-row {
    height: 3;
    margin-bottom: 0;
}

.field-row Input {
    width: 1fr;
    height: 3;
}

.browse-button {
    width: 12;
    height: 3;
    margin-left: 1;
}

#quality-slider {
    height: 1;
    margin-top: 0;
    color: $accent;
}

#quality-slider:focus {
    text-style: bold underline;
}

#validation-message {
    height: 1;
    margin-top: 1;
}

#compress-button {
    margin-top: 1;
    width: auto;
    min-width: 20;
}

/* --- Directory picker modal --- */

DirectoryPicker {
    align: center middle;
}

#picker-body {
    width: 70%;
    height: 70%;
    background: $panel;
    border: round $accent;
    padding: 1 2;
}

#picker-title {
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}

#picker-tree {
    height: 1fr;
    border: round $surface-lighten-1;
}

#picker-hint {
    color: $text-muted;
    height: 1;
    margin-top: 1;
}

#picker-actions {
    height: auto;
    margin-top: 1;
}

#picker-actions Button {
    margin-right: 2;
}

/* --- Processing screen --- */

#processing-title {
    text-style: bold;
    color: $accent;
    margin-top: 1;
    margin-bottom: 1;
}

#current-file {
    text-style: bold;
    width: 30;
    height: 1;
}

#files-counter,
#result-counters,
#elapsed-counter {
    height: 1;
    color: $text-muted;
}

#current-result {
    margin: 1 0;
    height: 2;
}

#cancel-button {
    margin-top: 2;
    width: auto;
}

/* --- Report screen --- */

#report-title {
    text-style: bold;
    color: $accent;
    margin-top: 1;
    margin-bottom: 1;
}

#report-summary {
    margin-bottom: 1;
}

#report-table {
    height: 1fr;
}

#selected-file-path {
    color: $text-muted;
    height: 1;
    margin-top: 1;
}

#report-actions {
    height: auto;
    padding: 1 2;
}

#report-actions Button {
    margin-right: 2;
}
